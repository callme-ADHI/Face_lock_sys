[Unit]
Description=FaceLock — Facial Authentication Daemon
After=network.target

[Service]
Type=simple
ExecStart=/root/facial_lock/venv/bin/python3 /root/facial_lock/facial_lock_daemon.py
ExecStop=/bin/rm -f /var/run/facial_lock.active /run/facial_lock.sock
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
